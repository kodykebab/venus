# GitHub App credentials - never commit the filled-in version.
GITHUB_APP_ID=
GITHUB_APP_SLUG=paracheck-ci
# Either the PEM contents inline, or a path to the .pem file.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: enables Claude synthesis. Without it reviews still post,
# rendered directly from the raw findings.
ANTHROPIC_API_KEY=

# Optional service tuning.
PARACHECK_DB=paracheck.db
PARACHECK_MIN_SEVERITY=low
PARACHECK_FAIL_ON=
PARACHECK_PUBLIC_URL=
