# GitHub App credentials - never commit the filled-in version.
GITHUB_APP_ID=
GITHUB_APP_SLUG=paracheck-ci
# Either the PEM contents inline, or a path to the .pem file.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Clerk account authentication for paid checkout. Create a JWT template/key in
# Clerk and paste its PEM verification key here. GitHub still controls repo access.
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_ISSUER=
CLERK_AUDIENCE=

# Future service: leave disabled for the initial launch. Reviews render from
# deterministic analyzer findings and never call Anthropic while this is 0.
PARACHECK_CLAUDE_ENABLED=0
ANTHROPIC_API_KEY=

# Optional service tuning.
PARACHECK_DB=paracheck.db
PARACHECK_MIN_SEVERITY=low
PARACHECK_FAIL_ON=
PARACHECK_PUBLIC_URL=
PARACHECK_CHAIN=monad

# Paid plans. New installations cannot review until Stripe confirms a plan.
STRIPE_SECRET_KEY=
STRIPE_HOBBY_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PARACHECK_HOBBY_PRICE=$29/mo
PARACHECK_PRO_PRICE=$99/mo

# Enterprise lead delivery opens the visitor's mail client with a prefilled enquiry.
ENTERPRISE_SALES_EMAIL=
