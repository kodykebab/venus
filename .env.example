# Monad Testnet
CHAIN_ID=10143

# Deploy / general use: the public Monad testnet RPC is fine.
# Dynamic analyzer (debug_traceBlockByNumber) needs debug_* support - use a dedicated
# QuickNode Monad Testnet endpoint there, NOT Ankr's public endpoint (blocks debug_*).
RPC_URL=https://testnet-rpc.monad.xyz

# Dedicated RPC with debug_* support, required by analyzer/dynamic/*
DYNAMIC_RPC_URL=

# api key from monadscan.com, used by `forge verify-contract`
MONADSCAN_API_KEY=

# Deployed contract addresses (filled in after step 4 of the build)
NAIVE_AMM_ADDRESS=
SHARDED_AMM_ADDRESS=
TOKEN0_ADDRESS=
TOKEN1_ADDRESS=

# Dedicated live-demo wallet private key (funded from faucet.monad.xyz).
# NEVER commit the real value - this stays in .env locally and in Vercel's
# encrypted env vars for the deployed /api/livetx function.
LIVETX_PRIVATE_KEY=
